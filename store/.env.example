# Velox store API - copy to .env and fill in.
# This file is safe to commit; .env is NOT (see .gitignore).

STORE_PORT=8090
STORE_DATA_DIR=data

# --- admin lock for veloxdownloader.prolanka.online/Admin ------------------
# Anyone with this password can edit the public site and change the price.
# Use something long. There is no recovery - change it here and restart.
STORE_ADMIN_PASS=change-me-to-something-long

# --- PayPal ----------------------------------------------------------------
# sandbox = test money, live = real money. Start with sandbox.
PAYPAL_MODE=sandbox
#
# Get these from https://developer.paypal.com/dashboard/applications
#   1. Log in with your PayPal Business account
#   2. Apps & Credentials -> pick the Sandbox or Live tab to match PAYPAL_MODE
#   3. Create App -> copy the Client ID and Secret below
# The secret stays on the server. It is never sent to the browser.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- what is being sold ----------------------------------------------------
# These are fallbacks. The live values are edited at /Admin and stored in
# data/content.json; the price there is re-validated before it reaches PayPal.
VELOX_PRICE=19.99
VELOX_CURRENCY=USD
VELOX_PRODUCT=Velox Downloader Pro - 1 year licence

# How long a purchased key lasts. 365 = one year (matches $19.99/yr).
# Set to 0 for lifetime keys if you change the offer.
VELOX_LICENCE_DAYS=365

# --- talking to the licence server ----------------------------------------
# The Node licence server in server/, reachable over loopback on the same box.
LICENCE_SERVER_URL=http://127.0.0.1:4000

# Shared secret for POST /internal/issue-key. Put the SAME value in
# server/.env as VELOX_INTERNAL_TOKEN. Generate one with:
#   openssl rand -hex 32
VELOX_INTERNAL_TOKEN=

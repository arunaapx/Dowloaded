# Copy to .env and fill in
PORT=4000

# Admin login for /admin (Basic auth)
ADMIN_USER=admin
ADMIN_PASS=change-me-please

# Client JWT lifetime in hours
TOKEN_TTL_HOURS=24

# Default validity for self-signup/admin-created keys.
# Use 0 for lifetime keys.
DEFAULT_LICENSE_DAYS=30

# Optional: persistent secret. If unset, a secret is generated and stored in data/.jwt-secret
# JWT_SECRET=

# Optional: custom data dir (default: ./data)
# DATA_DIR=/var/lib/velox-license

# --- thin-client extraction guards (server/extract.js + usage.js) ---
# Set in production. NEVER set LICENSE_DEV_BYPASS in production (it disables the license check).
# LICENSE_DEV_BYPASS=0

# yt-dlp network guards for extraction
VELOX_SOCKET_TIMEOUT_SEC=20
VELOX_DL_RETRIES=1
VELOX_EXTRACT_TIMEOUT_SEC=45

# Per-license abuse limits (stop account-sharing-as-API)
VELOX_DAILY_CAP=300      # extract+resolve calls per key per day
VELOX_IP_ALERT=6         # distinct IPs/hour -> log an anomaly event
VELOX_IP_BLOCK=25        # distinct IPs/hour -> auto-block the key

# Set in production so Secure cookies + correct behavior kick in
NODE_ENV=production

{
  "name": "velox-downloader",
  "version": "2.1.0",
  "description": "Velox Downloader — licensed desktop app for YouTube, Facebook, TikTok, Instagram, and 1000+ sites. Server-gated extraction, device-side download.",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win",
    "web": "node web/server.js"
  },
  "keywords": [
    "video",
    "downloader",
    "youtube",
    "facebook",
    "tiktok",
    "yt-dlp"
  ],
  "author": {
    "name": "H A P Sarathchandra",
    "company": "The Hard Worker Corporation"
  },
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.prolanka.veloxdownloader",
    "productName": "Velox Downloader",
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "bin/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}

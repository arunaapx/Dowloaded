{
  "name": "velox-downloader",
  "version": "2.3.0",
  "description": "Velox Downloader — licensed desktop app for YouTube, Facebook, TikTok, Instagram, and 1000+ sites. Server-gated extraction, device-side download.",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win",
    "web": "node web/server.js",
    "release": "node scripts/release.js",
    "engine:build": "node scripts/build-engine.js",
    "engine:smoke": "node engine/smoke.js",
    "engine:bench": "node engine/bench.js",
    "prebuild": "node scripts/build-engine.js && node scripts/brand-engine.js",
    "engine:brand": "node scripts/brand-engine.js"
  },
  "keywords": [
    "video",
    "downloader",
    "youtube",
    "facebook",
    "tiktok"
  ],
  "author": {
    "name": "H A P Sarathchandra",
    "company": "The Hard Worker Corporation"
  },
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.prolanka.veloxdownloader",
    "productName": "Velox Downloader",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      {
        "from": "node_modules/request-promise-core",
        "to": "node_modules/request-promise-core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/koffi",
        "to": "node_modules/koffi",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "bin/velox-core.exe",
        "to": "bin/velox-core.exe"
      },
      {
        "from": "bin/_internal",
        "to": "bin/_internal"
      },
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "bin/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      },
      {
        "from": "bin/qjs.exe",
        "to": "bin/qjs.exe"
      },
      {
        "from": "bin/velox_engine.dll",
        "to": "bin/velox_engine.dll"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Velox Downloader",
      "uninstallDisplayName": "Velox Downloader ${version}",
      "artifactName": "VeloxDownloader-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "VeloxDownloader-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://veloxdownloader.prolanka.online/updates/",
        "channel": "latest"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.2.1",
    "request-promise-core": "1.1.4",
    "torrent-search-api": "^2.1.4",
    "webtorrent": "^3.0.21"
  }
}
